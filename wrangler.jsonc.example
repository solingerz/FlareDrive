/**
 * Reference config. The repo also includes a committed `wrangler.jsonc`
 * so deploys have a Worker entrypoint and assets directory by default.
 *
 * Fill the bindings below before using storage-backed features.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flare-drive",
  "main": "src/worker.ts",
  "compatibility_date": "2026-02-12",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": "./build",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "drive.example.com/*",
      "zone_name": "example.com"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "your-r2-bucket"
    }
  ],
  // Optional: remove or leave commented out unless share links are enabled.
  // "kv_namespaces": [
  //   {
  //     "binding": "SHARE_KV",
  //     "id": "your-kv-namespace-id"
  //   }
  // ],
  "vars": {
    "WEBDAV_PUBLIC_READ": "false",
    "SHARE_ENABLED": "false",
    "SHARE_DEFAULT_EXPIRE_SECONDS": "3600"
  },
  "workers_dev": false,
  "preview_urls": false,
}
