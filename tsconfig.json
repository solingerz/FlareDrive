{
  "compilerOptions": {
    "target": "es2021",
    "lib": ["es2021", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "module": "commonjs",
    "paths": {
      "@/*": ["./*"]
    },
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["src/**/*", "functions/**/*", "utils/**/*"],
  "exclude": ["node_modules", "build", "Main.tsx", "TextPadDrawer.tsx", "BUG_AUDIT.md"]
}
